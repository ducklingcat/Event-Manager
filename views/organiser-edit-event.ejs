<%# start %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Organiser Edit Event Page</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <div class="container">
        <p class="back-link"><a class="button secondary" href="/organiser">&larr; Back to Organiser Home</a></p>

        <div class="page-header">
            <h1>Organiser Edit Event Page</h1>
            <p class="event-meta">Created: <%= formatDateTime(event.created_at) %></p>
        </div>

        <% if (success) { %>
            <div class="success-message"><%= success %></div>
        <% } %>

        <% if (errors.length > 0) { %>
            <div class="error-messages">
                <ul>
                    <% errors.forEach(function(message) { %>
                        <li><%= message %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <form class="stacked" action="/organiser/events/<%= event.event_id %>" method="POST">
            <label for="title">Event Title</label>
            <input type="text" id="title" name="title" value="<%= event.title %>" required>

            <label for="description">Event Description</label>
            <textarea id="description" name="description" required><%= event.description %></textarea>

            <label for="event_date">Event Date</label>
            <input type="date" id="event_date" name="event_date" value="<%= event.event_date || '' %>" min="<%= minEventDate %>">

            <label for="full_price_tickets">Number of Full-Price Tickets</label>
            <input type="number" id="full_price_tickets" name="full_price_tickets" value="<%= event.full_price_tickets %>" min="0" step="1" required>

            <label for="full_price_cost">Full-Price Ticket Cost</label>
            <input type="number" id="full_price_cost" name="full_price_cost" value="<%= event.full_price_cost %>" min="0" step="0.01" required>

            <label for="concession_tickets">Number of Concession Tickets</label>
            <input type="number" id="concession_tickets" name="concession_tickets" value="<%= event.concession_tickets %>" min="0" step="1" required>

            <label for="concession_cost">Concession Ticket Cost</label>
            <input type="number" id="concession_cost" name="concession_cost" value="<%= event.concession_cost %>" min="0" step="0.01" required>

            <div class="form-actions">
                <button type="submit">Submit Changes</button>
            </div>
        </form>
    </div>
</body>
</html>
<%# end %>